<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release builds need this declared here, not only in the debug and
         profile manifests. Without it the shipped APK cannot resolve any
         hostname, and every Supabase call fails at DNS with "Failed host
         lookup ... OS Error: No address associated with hostname, errno = 7". -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The map and `match_offers_for_trip`. `driver_locations` has to hold a
         row for this driver before the matcher will offer them a trip at all,
         and nothing writes that row without a position from the device.
         FINE is a GPS-grade fix for the pickup pin; COARSE is declared alongside
         it because Android 12+ lets the user grant only the approximate one,
         and a driver who does that still gets matched, just less precisely. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- The selfie step of KYC, via `image_picker`'s camera source. Without
         this the camera does not open: `ImagePicker.pickImage` returns null on
         a denied or undeclared permission, so the step could never be
         completed and no driver could ever finish onboarding.

         `required="false"` because a phone without a camera is a legitimate
         device: the app installs and runs everywhere else, and only the selfie
         button is unavailable on it. Declaring it required would exclude those
         devices from the store listing and from the pilot's phone.

         Note for whoever edits this file: XML forbids a double hyphen inside a
         comment, and a manifest containing one fails Gradle's manifest merger
         with "Error parsing" and no line number. Write an em dash in full. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- A heading comes off the same fix the position does, so there is no
         extra sensor permission to declare here: ACCESS_FINE_LOCATION is what
         carries a compass bearing. A device with no magnetometer reports no
         heading at all, which the app draws as no car rather than as one
         pointing the wrong way. -->
    <application
        android:label="meetngo_driver"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
