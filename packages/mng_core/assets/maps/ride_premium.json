{
  "version": 8,
  "name": "Meet 'N Go Premium",
  "metadata": {
    "mng:palette": {
      "land": "#F4F4F6",
      "water": "#C4D3DF",
      "park": "#E2F0D9",
      "road": "#FFFFFF",
      "roadCasing": "#E0E0E5",
      "building": "#E5E7EB",
      "label": "#8A8A8E",
      "labelStrong": "#6E6E73",
      "labelPoi": "#5A5A5F",
      "car": "#F5B301"
    },
    "mng:declutter": "Street names and place names are the map's job: a road network with no street names cannot be navigated to a junction, and a map that does not say whether it is Osu or Tema is not orientable. Points of interest are drawn as well, because a rider choosing a pickup wants to see that the corner they tapped has a bank or a pharmacy on it rather than only that it has a road. They are rank-filtered rather than exhaustive: the tiles carry a `rank` from 1 (most important) downwards and only the first slice of it is drawn, so a neighbourhood shows its hospital and its filling stations and not every one of its forty-eight restaurants. This reverses an earlier decision to hide business names outright, which made the map honest but useless for picking a landmark. The `poi` source layer stops at zoom 14, so nothing is drawn above it and nothing is invented above it either."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
