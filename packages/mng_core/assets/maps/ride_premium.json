{
  "version": 8,
  "name": "Meet 'N Go Premium",
  "metadata": {
    "mng:palette": {
      "land": "#F4F4F6",
      "water": "#C4D3DF",
      "park": "#E2F0D9",
      "road": "#FFFFFF",
      "roadCasing": "#E0E0E5",
      "building": "#E5E7EB",
      "label": "#8A8A8E",
      "car": "#F5B301"
    },
    "mng:declutter": "No poi, housenumber, aerodrome_label, mountain_peak or boundary layer exists. Text is deliberately limited to place and road names: a road network with no street names on it cannot be navigated to a junction, and a map that does not say whether it is Osu or Tema is not orientable. Business and commercial names are the noise being removed, and no layer draws one."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openfreemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors"
    },
    "vehicles": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F4F4F6"
      }
    },
    {
      "id": "park-fill",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "grass", "scrub", "farmland"]]],
      "paint": {
        "fill-color": "#E2F0D9",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "park-fill-polygons",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["park", "garden", "recreation_ground", "cemetery", "golf_course", "pitch", "playground", "grass", "village_green", "allotments"]]
      ],
      "paint": {
        "fill-color": "#E2F0D9",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "fill-color": "#C4D3DF",
        "fill-opacity": 1
      }
    },
    {
      "id": "waterway-line",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#C4D3DF",
        "line-opacity": 1,
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 10, 0.6, 14, 3, 18, 8]
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openfreemap",
      "source-layer": "building",
      "minzoom": 13,
      "filter": ["!=", ["get", "hide_3d"], true],
      "paint": {
        "fill-extrusion-color": "#E5E7EB",
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          ["*", ["get", "render_height"], 0.85],
          15,
          ["*", ["get", "render_height"], 1.0],
          18,
          ["*", ["get", "render_height"], 1.15]
        ],
        "fill-extrusion-base": ["get", "render_min_height"],
        "fill-extrusion-opacity": 0.9,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": {
        "line-cap": "butt",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "#E0E0E5",
        "line-opacity": 1,
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 6, 0.6, 10, 1.4, 14, 3.4, 18, 11]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-opacity": 1,
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 6, 0.4, 10, 1.0, 14, 2.4, 18, 8.5]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-opacity": 1,
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 8, 0.3, 12, 0.9, 16, 3.2, 18, 6]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["minor", "service", "track", "path"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-opacity": 0.85,
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 12, 0.25, 15, 1.0, 18, 3.2]
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openfreemap",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "suburb", "neighbourhood", "quarter", "village"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 9, 13, 12, 15],
        "text-transform": "none",
        "text-letter-spacing": 0.1,
        "text-anchor": "center",
        "text-allow-overlap": false,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#8A8A8E",
        "text-halo-color": "#F4F4F6",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "openfreemap",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["!=", ["get", "class"], "path"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 16, 12, 18, 13],
        "text-letter-spacing": 0.05,
        "text-max-angle": 30,
        "text-padding": 4,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#8A8A8E",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "moving-car-icon",
      "type": "symbol",
      "source": "vehicles",
      "layout": {
        "icon-image": "car-topdown",
        "icon-size": 0.6,
        "icon-rotate": ["coalesce", ["get", "bearing"], 0],
        "icon-rotation-alignment": "map",
        "icon-pitch-alignment": "map",
        "icon-allow-overlap": true,
        "icon-ignore-placement": true,
        "icon-anchor": "center"
      }
    }
  ]
}
